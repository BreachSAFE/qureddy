# IDE consistency. Read by most editors automatically.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false  # markdown soft breaks use trailing whitespace

[justfile]
indent_size = 4

[Makefile]
indent_style = tab
