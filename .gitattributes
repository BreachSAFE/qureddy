# Enforce LF line endings everywhere. Windows contributors should use
# Git's autocrlf for working tree, but commits are always LF.

* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.justfile text eol=lf
justfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
LICENSE text eol=lf

# Binary file types: do not touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.whl binary

# Test fixtures may contain captured binary or quasi-binary content.
# Treat as text by default but allow per-file override if a binary
# fixture is added later.
tests/fixtures/openssl/* text eol=lf
