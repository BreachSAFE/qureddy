        "value": "2026-04-26T00:00:00+00:00"
      },
      {
        "name": "qureddy:scan.id",
        "value": "scan-1"
      },
      {
        "name": "qureddy:scan.readiness",
        "value": "transitional_hybrid"
      },
      {
        "name": "qureddy:scan.scanner_name",
        "value": "tls"
      },
      {
