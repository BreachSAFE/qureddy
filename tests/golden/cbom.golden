{
  "$schema": "http://cyclonedx.org/schema/bom-1.7.schema.json",
  "bomFormat": "CycloneDX",
  "components": [
    {
      "bom-ref": "crypto/protocol/tls-tlsv1.3",
      "cryptoProperties": {
        "assetType": "protocol",
        "protocolProperties": {
          "cipherSuites": [
            {
              "algorithms": [
                "crypto/algorithm/x25519",
                "crypto/algorithm/x25519mlkem768"
              ],
              "name": "TLS_AES_256_GCM_SHA384"
            }
          ],
          "type": "tls",
          "version": "1.3"
        }
      },
      "name": "TLSv1.3",
      "type": "cryptographic-asset"
    },
    {
      "bom-ref": "crypto/algorithm/x25519",
      "cryptoProperties": {
        "algorithmProperties": {
          "cryptoFunctions": [
            "keygen"
          ],
          "curve": "curve25519",
          "nistQuantumSecurityLevel": 0,
          "primitive": "key-agree"
        },
        "assetType": "algorithm"
      },
      "name": "X25519",
      "type": "cryptographic-asset"
    },
    {
      "bom-ref": "crypto/algorithm/x25519mlkem768",
      "cryptoProperties": {
        "algorithmProperties": {
          "cryptoFunctions": [
            "decapsulate",
            "encapsulate",
            "keygen"
          ],
          "nistQuantumSecurityLevel": 3,
          "parameterSetIdentifier": "ML-KEM-768",
          "primitive": "kem"
        },
        "assetType": "algorithm"
      },
      "name": "X25519MLKEM768",
      "type": "cryptographic-asset"
    }
  ],
  "dependencies": [
    {
      "ref": "crypto/algorithm/x25519"
    },
    {
      "ref": "crypto/algorithm/x25519mlkem768"
    },
    {
      "ref": "crypto/protocol/tls-tlsv1.3"
    },
    {
      "provides": [
        "crypto/algorithm/x25519",
        "crypto/algorithm/x25519mlkem768",
        "crypto/protocol/tls-tlsv1.3"
      ],
      "ref": "endpoint"
    }
  ],
  "metadata": {
    "component": {
      "bom-ref": "endpoint",
      "name": "example.com:443",
      "type": "application"
    },
    "properties": [
      {
