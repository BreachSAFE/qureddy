        "value": "2026-04-26T00:00:00+00:00"
      },
      {
        "name": "qureddy:scan.status",
        "value": "completed"
      },
      {
        "name": "qureddy:scan.total_attempts",
        "value": "2"
      },
      {
        "name": "qureddy:target.host",
        "value": "example.com"
      },
      {
        "name": "qureddy:target.locator",
        "value": "tls://example.com:443"
      },
      {
        "name": "qureddy:target.original_input",
        "value": "example.com"
      },
      {
